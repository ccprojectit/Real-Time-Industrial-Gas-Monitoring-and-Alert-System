APP_ENV=development
DATABASE_URL=postgresql://gas_monitor_app:REPLACE_WITH_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=operator
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_REQUIRED=false
SIMULATOR_INTERVAL_SECONDS=1
SIMULATOR_MAX_RUNTIME_SECONDS=900
CRITICAL_SIMULATION_COOLDOWN_SECONDS=5
SMS_MODE=mock
SMS_ENABLED=false
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in
EXOTEL_SENDER_ID=
EXOTEL_DLT_ENTITY_ID=
EXOTEL_DLT_TEMPLATE_ID=
EXOTEL_SMS_TYPE=
SMS_RECIPIENT_NUMBER=
